{
  "name": "nihongo-notes",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "deno@2.9.4",
  "engines": {
    "deno": ">=2.9.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "deno task validate:content && astro check && astro build",
    "check": "astro check",
    "validate:content": "deno run --allow-read=src/content/classes,src/data/reference.ts scripts/validate-content.mjs",
    "security:check": "deno outdated --frozen --compatible",
    "preview": "astro preview"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/shippori-mincho": "5.3.0",
    "@fontsource/zen-kaku-gothic-new": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "astro": "7.1.6"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@oslojs/encoding": "1.1.0",
    "clsx": "2.1.1",
    "cookie": "2.0.1",
    "devalue": "5.9.0",
    "es-module-lexer": "2.3.1",
    "html-escaper": "3.0.3",
    "neotraverse": "1.0.1",
    "piccolore": "0.1.3",
    "typescript": "5.9.3",
    "unstorage": "1.17.5",
    "zod": "4.4.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
